      "name": "Project Management",
      "item": [
        {
          "name": "1. Create Project - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();\n\npm.test(\"Project Created Successfully\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\nif (jsonData.id || (jsonData.data && jsonData.data.id)) {\n    var newProjectId = jsonData.id || jsonData.data.id;\n    pm.collectionVariables.set(\"projectId\", newProjectId);\n    console.log(\"Saved Project ID:\", newProjectId);\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{json_web_token_13hb}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
