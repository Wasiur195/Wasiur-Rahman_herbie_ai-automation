    {
      "name": "Login Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// JSON Response safe handling\ntry {\n    var jsonData = pm.response.json();\n    var token = jsonData.token || jsonData.access_token || jsonData.jwt;\n    if (token) {\n        pm.environment.set(\"authToken\", token);\n    }\n} catch (e) {\n    console.log(\"Response is not JSON:\", e);\n}\nvar jsonData = pm.response.json();\n\n// Backend token Key er name token, access_token ba jwt hote pare\nvar token = jsonData.token || jsonData.access_token || jsonData.jwt;\n\nif (token) {\n    pm.environment.set(\"authToken\", token);\n    console.log(\"Token saved successfully:\", token);\n} else {\n    console.log(\"Token key not found in response body!\");\n}\nvar jsonData = pm.response.json();\nvar token = jsonData.token || jsonData.access_token || (jsonData.data && jsonData.data.token);\nif (token) {\n    pm.collectionVariables.set(\"authToken\", token);\n    console.log(\"Token Updated Successfully!\");\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"wasiurrahman195@gmail.com\",\n  \"password\": \"E5q5WNuzCAzYyqw\"\n}",
          "options": {
